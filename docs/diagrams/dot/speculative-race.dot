digraph SpeculativeRace {
    rankdir=LR;
    nodesep=0.5;
    ranksep=0.75;
    forcelabels="true";
    overlap="false";
    fontname="Helvetica,Arial,sans-serif";
    outputorder="edgesfirst";
    compound="true";
    node [fontname="Helvetica,Arial,sans-serif", fontsize=12];
    edge [fontname="Helvetica,Arial,sans-serif", fontsize=10];

    p_REQUEST [label="", shape="circle", style="filled,dashed", fillcolor="#f8d7da", color="#721c24", penwidth=2, width=0.35, xlabel="REQUEST", fixedsize="true"];
    p_SLOW_INFLIGHT [label="", shape="circle", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1.5, width=0.35, xlabel="SLOW_INFLIGHT", fixedsize="true"];
    p_FAST_INFLIGHT [label="", shape="circle", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1.5, width=0.35, xlabel="FAST_INFLIGHT", fixedsize="true"];
    p_TIMER_PENDING [label="", shape="circle", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1.5, width=0.35, xlabel="TIMER_PENDING", fixedsize="true"];
    p_TIMER_EXPIRED [label="", shape="circle", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1.5, width=0.35, xlabel="TIMER_EXPIRED", fixedsize="true"];
    p_SLOW_DONE [label="", shape="circle", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1.5, width=0.35, xlabel="SLOW_DONE", fixedsize="true"];
    p_FAST_DONE [label="", shape="circle", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1.5, width=0.35, xlabel="FAST_DONE", fixedsize="true"];
    p_RESPONSE [label="", shape="circle", style="filled,dashed", fillcolor="#f8d7da", color="#721c24", penwidth=2, width=0.35, xlabel="RESPONSE", fixedsize="true"];
    p_RESPONSE_SENT [label="", shape="doublecircle", style="filled", fillcolor="#cce5ff", color="#004085", penwidth=2, width=0.35, xlabel="RESPONSE_SENT", fixedsize="true"];
    p_USER_INTERRUPT [label="", shape="circle", style="filled,dashed", fillcolor="#f8d7da", color="#721c24", penwidth=2, width=0.35, xlabel="USER_INTERRUPT", fixedsize="true"];
    p_CANCELED [label="", shape="circle", style="filled,dashed", fillcolor="#f8d7da", color="#721c24", penwidth=2, width=0.35, xlabel="CANCELED", fixedsize="true"];
    t_StartBoth [label="StartBoth [0, ∞]ms", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    t_TimerFires [label="TimerFires [2000, ∞]ms", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    t_SlowCompletes [label="SlowCompletes [0, ∞]ms", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    t_FastCompletes [label="FastCompletes [0, ∞]ms", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    t_CommitSlow [label="CommitSlow [0, ∞]ms", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    t_CommitFastOnTimeout [label="CommitFastOnTimeout [0, ∞]ms", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    t_OnBargeInOrNewTurn [label="OnBargeInOrNewTurn [0, ∞]ms", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    j_StartBoth__and_0 [label="✚", shape="diamond", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1, height=0.3, width=0.3, fixedsize="true", fontsize=14];
    j_CommitSlow__and_0 [label="✚", shape="diamond", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1, height=0.3, width=0.3, fixedsize="true", fontsize=14];
    j_CommitFastOnTimeout__and_0 [label="✚", shape="diamond", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1, height=0.3, width=0.3, fixedsize="true", fontsize=14];

    p_REQUEST -> t_StartBoth [color="#333333", style="solid", arrowhead="normal"];
    t_StartBoth -> j_StartBoth__and_0 [color="#333333", style="solid", arrowhead="normal"];
    j_StartBoth__and_0 -> p_SLOW_INFLIGHT [color="#333333", style="solid", arrowhead="normal"];
    j_StartBoth__and_0 -> p_FAST_INFLIGHT [color="#333333", style="solid", arrowhead="normal"];
    j_StartBoth__and_0 -> p_TIMER_PENDING [color="#333333", style="solid", arrowhead="normal"];
    p_TIMER_PENDING -> t_TimerFires [color="#333333", style="solid", arrowhead="normal"];
    t_TimerFires -> p_TIMER_EXPIRED [color="#333333", style="solid", arrowhead="normal"];
    p_SLOW_INFLIGHT -> t_SlowCompletes [color="#333333", style="solid", arrowhead="normal"];
    t_SlowCompletes -> p_SLOW_DONE [color="#333333", style="solid", arrowhead="normal"];
    p_FAST_INFLIGHT -> t_FastCompletes [color="#333333", style="solid", arrowhead="normal"];
    t_FastCompletes -> p_FAST_DONE [color="#333333", style="solid", arrowhead="normal"];
    p_SLOW_DONE -> t_CommitSlow [color="#333333", style="solid", arrowhead="normal"];
    t_CommitSlow -> j_CommitSlow__and_0 [color="#333333", style="solid", arrowhead="normal"];
    j_CommitSlow__and_0 -> p_RESPONSE [color="#333333", style="solid", arrowhead="normal"];
    j_CommitSlow__and_0 -> p_RESPONSE_SENT [color="#333333", style="solid", arrowhead="normal"];
    p_RESPONSE_SENT -> t_CommitSlow [color="#dc3545", style="solid", arrowhead="odot"];
    p_FAST_DONE -> t_CommitFastOnTimeout [color="#333333", style="solid", arrowhead="normal"];
    p_TIMER_EXPIRED -> t_CommitFastOnTimeout [color="#333333", style="solid", arrowhead="normal"];
    t_CommitFastOnTimeout -> j_CommitFastOnTimeout__and_0 [color="#333333", style="solid", arrowhead="normal"];
    j_CommitFastOnTimeout__and_0 -> p_RESPONSE [color="#333333", style="solid", arrowhead="normal"];
    j_CommitFastOnTimeout__and_0 -> p_RESPONSE_SENT [color="#333333", style="solid", arrowhead="normal"];
    p_RESPONSE_SENT -> t_CommitFastOnTimeout [color="#dc3545", style="solid", arrowhead="odot"];
    p_USER_INTERRUPT -> t_OnBargeInOrNewTurn [color="#333333", style="solid", arrowhead="normal"];
    t_OnBargeInOrNewTurn -> p_CANCELED [color="#333333", style="solid", arrowhead="normal"];
    t_OnBargeInOrNewTurn -> p_SLOW_INFLIGHT [color="#fd7e14", style="bold", arrowhead="normal", label="reset", penwidth=2];
    t_OnBargeInOrNewTurn -> p_FAST_INFLIGHT [color="#fd7e14", style="bold", arrowhead="normal", label="reset", penwidth=2];
    t_OnBargeInOrNewTurn -> p_SLOW_DONE [color="#fd7e14", style="bold", arrowhead="normal", label="reset", penwidth=2];
    t_OnBargeInOrNewTurn -> p_FAST_DONE [color="#fd7e14", style="bold", arrowhead="normal", label="reset", penwidth=2];
    t_OnBargeInOrNewTurn -> p_TIMER_PENDING [color="#fd7e14", style="bold", arrowhead="normal", label="reset", penwidth=2];
    t_OnBargeInOrNewTurn -> p_TIMER_EXPIRED [color="#fd7e14", style="bold", arrowhead="normal", label="reset", penwidth=2];
    t_OnBargeInOrNewTurn -> p_RESPONSE_SENT [color="#fd7e14", style="bold", arrowhead="normal", label="reset", penwidth=2];
}