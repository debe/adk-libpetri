digraph SketchTieredSlaLadder {
    rankdir=TB;
    nodesep=0.3;
    ranksep=0.75;
    forcelabels="true";
    overlap="false";
    fontname="Helvetica,Arial,sans-serif";
    outputorder="edgesfirst";
    compound="true";
    bgcolor="white";
    pad="0.15";
    node [fontname="Helvetica,Arial,sans-serif", fontsize=12];
    edge [fontname="Helvetica,Arial,sans-serif", fontsize=12];

    p_REQUEST [label="REQUEST", shape="ellipse", style="filled,dashed", fillcolor="#f8d7da", color="#721c24", penwidth=2, height=0.3, width=0.3, fixedsize="false", margin="0.08,0.03"];
    p_PRIMARY_CALL [label="PRIMARY_CALL", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1.5, height=0.3, width=0.3, fixedsize="false", margin="0.08,0.03"];
    p_RUNG_1 [label="RUNG_1", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1.5, height=0.3, width=0.3, fixedsize="false", margin="0.08,0.03"];
    p_ANSWERED [label="ANSWERED", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1.5, height=0.3, width=0.3, fixedsize="false", margin="0.08,0.03"];
    p_DISCARDED [label="DISCARDED", shape="ellipse", style="filled", fillcolor="#cce5ff", color="#004085", penwidth=2, height=0.3, width=0.3, fixedsize="false", margin="0.08,0.03", peripheries=2];
    p_PRIMARY_DONE [label="PRIMARY_DONE", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1.5, height=0.3, width=0.3, fixedsize="false", margin="0.08,0.03"];
    p_EVENT_OUT [label="EVENT_OUT", shape="ellipse", style="filled", fillcolor="#cce5ff", color="#004085", penwidth=2, height=0.3, width=0.3, fixedsize="false", margin="0.08,0.03", peripheries=2];
    p_RUNG_2 [label="RUNG_2", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1.5, height=0.3, width=0.3, fixedsize="false", margin="0.08,0.03"];
    p_FALLBACK_CALL [label="FALLBACK_CALL", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1.5, height=0.3, width=0.3, fixedsize="false", margin="0.08,0.03"];
    p_FALLBACK_DONE [label="FALLBACK_DONE", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1.5, height=0.3, width=0.3, fixedsize="false", margin="0.08,0.03"];
    p_RUNG_3 [label="RUNG_3", shape="ellipse", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1.5, height=0.3, width=0.3, fixedsize="false", margin="0.08,0.03"];
    t_Sla_Start [label="Sla_Start", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    t_Sla_CallPrimary [label="Sla_CallPrimary", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    t_Sla_AnswerPrimary [label="Sla_AnswerPrimary prio=10", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    t_Sla_Escalate1 [label="Sla_Escalate1 [2000, ∞]ms", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    t_Sla_CallFallback [label="Sla_CallFallback", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    t_Sla_AnswerPrimaryLate [label="Sla_AnswerPrimaryLate prio=10", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    t_Sla_AnswerFallback [label="Sla_AnswerFallback prio=5", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    t_Sla_Escalate2 [label="Sla_Escalate2 [3000, ∞]ms", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    t_Sla_AnswerCached [label="Sla_AnswerCached", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    t_Sla_DiscardPrimary [label="Sla_DiscardPrimary prio=-10", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    t_Sla_DiscardFallback [label="Sla_DiscardFallback prio=-10", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    j_Sla_Start__and_0 [label="✚", shape="diamond", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1, height=0.3, width=0.3, fixedsize="true", fontsize=14, ordering="out"];
    j_Sla_AnswerPrimary__and_0 [label="✚", shape="diamond", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1, height=0.3, width=0.3, fixedsize="true", fontsize=14, ordering="out"];
    j_Sla_Escalate1__and_0 [label="✚", shape="diamond", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1, height=0.3, width=0.3, fixedsize="true", fontsize=14, ordering="out"];
    j_Sla_AnswerPrimaryLate__and_0 [label="✚", shape="diamond", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1, height=0.3, width=0.3, fixedsize="true", fontsize=14, ordering="out"];
    j_Sla_AnswerFallback__and_0 [label="✚", shape="diamond", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1, height=0.3, width=0.3, fixedsize="true", fontsize=14, ordering="out"];
    j_Sla_AnswerCached__and_0 [label="✚", shape="diamond", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1, height=0.3, width=0.3, fixedsize="true", fontsize=14, ordering="out"];

    p_REQUEST -> t_Sla_Start [color="#333333", style="solid", arrowhead="normal"];
    t_Sla_Start -> j_Sla_Start__and_0 [color="#333333", style="solid", arrowhead="normal"];
    j_Sla_Start__and_0 -> p_PRIMARY_CALL [color="#333333", style="solid", arrowhead="normal"];
    j_Sla_Start__and_0 -> p_RUNG_1 [color="#333333", style="solid", arrowhead="normal"];
    p_PRIMARY_CALL -> t_Sla_CallPrimary [color="#333333", style="solid", arrowhead="normal"];
    t_Sla_CallPrimary -> p_PRIMARY_DONE [color="#333333", style="solid", arrowhead="normal"];
    p_PRIMARY_DONE -> t_Sla_AnswerPrimary [color="#333333", style="solid", arrowhead="normal"];
    p_RUNG_1 -> t_Sla_AnswerPrimary [color="#333333", style="solid", arrowhead="normal"];
    t_Sla_AnswerPrimary -> j_Sla_AnswerPrimary__and_0 [color="#333333", style="solid", arrowhead="normal"];
    j_Sla_AnswerPrimary__and_0 -> p_EVENT_OUT [color="#333333", style="solid", arrowhead="normal"];
    j_Sla_AnswerPrimary__and_0 -> p_ANSWERED [color="#333333", style="solid", arrowhead="normal"];
    p_RUNG_1 -> t_Sla_Escalate1 [color="#333333", style="solid", arrowhead="normal"];
    t_Sla_Escalate1 -> j_Sla_Escalate1__and_0 [color="#333333", style="solid", arrowhead="normal"];
    j_Sla_Escalate1__and_0 -> p_RUNG_2 [color="#333333", style="solid", arrowhead="normal"];
    j_Sla_Escalate1__and_0 -> p_FALLBACK_CALL [color="#333333", style="solid", arrowhead="normal"];
    p_FALLBACK_CALL -> t_Sla_CallFallback [color="#333333", style="solid", arrowhead="normal"];
    t_Sla_CallFallback -> p_FALLBACK_DONE [color="#333333", style="solid", arrowhead="normal"];
    p_PRIMARY_DONE -> t_Sla_AnswerPrimaryLate [color="#333333", style="solid", arrowhead="normal"];
    p_RUNG_2 -> t_Sla_AnswerPrimaryLate [color="#333333", style="solid", arrowhead="normal"];
    t_Sla_AnswerPrimaryLate -> j_Sla_AnswerPrimaryLate__and_0 [color="#333333", style="solid", arrowhead="normal"];
    j_Sla_AnswerPrimaryLate__and_0 -> p_EVENT_OUT [color="#333333", style="solid", arrowhead="normal"];
    j_Sla_AnswerPrimaryLate__and_0 -> p_ANSWERED [color="#333333", style="solid", arrowhead="normal"];
    p_FALLBACK_DONE -> t_Sla_AnswerFallback [color="#333333", style="solid", arrowhead="normal"];
    p_RUNG_2 -> t_Sla_AnswerFallback [color="#333333", style="solid", arrowhead="normal"];
    t_Sla_AnswerFallback -> j_Sla_AnswerFallback__and_0 [color="#333333", style="solid", arrowhead="normal"];
    j_Sla_AnswerFallback__and_0 -> p_EVENT_OUT [color="#333333", style="solid", arrowhead="normal"];
    j_Sla_AnswerFallback__and_0 -> p_ANSWERED [color="#333333", style="solid", arrowhead="normal"];
    p_RUNG_2 -> t_Sla_Escalate2 [color="#333333", style="solid", arrowhead="normal"];
    t_Sla_Escalate2 -> p_RUNG_3 [color="#333333", style="solid", arrowhead="normal"];
    p_RUNG_3 -> t_Sla_AnswerCached [color="#333333", style="solid", arrowhead="normal"];
    t_Sla_AnswerCached -> j_Sla_AnswerCached__and_0 [color="#333333", style="solid", arrowhead="normal"];
    j_Sla_AnswerCached__and_0 -> p_EVENT_OUT [color="#333333", style="solid", arrowhead="normal"];
    j_Sla_AnswerCached__and_0 -> p_ANSWERED [color="#333333", style="solid", arrowhead="normal"];
    p_PRIMARY_DONE -> t_Sla_DiscardPrimary [color="#333333", style="solid", arrowhead="normal"];
    t_Sla_DiscardPrimary -> p_DISCARDED [color="#333333", style="solid", arrowhead="normal"];
    p_ANSWERED -> t_Sla_DiscardPrimary [color="#6c757d", style="dashed", arrowhead="normal"];
    p_FALLBACK_DONE -> t_Sla_DiscardFallback [color="#333333", style="solid", arrowhead="normal"];
    t_Sla_DiscardFallback -> p_DISCARDED [color="#333333", style="solid", arrowhead="normal"];
    p_ANSWERED -> t_Sla_DiscardFallback [color="#6c757d", style="dashed", arrowhead="normal"];
    n_Sla_Start__resets [label="reset: ANSWERED, DISCARDED", shape="note", style="filled", fillcolor="#fff4e6", color="#fd7e14", penwidth=1.5];
    t_Sla_Start -> n_Sla_Start__resets [color="#fd7e14", style="bold", arrowhead="normal", penwidth=2];
}