digraph BidiComposition {
    rankdir=LR;
    nodesep=0.5;
    ranksep=0.75;
    forcelabels="true";
    overlap="false";
    fontname="Helvetica,Arial,sans-serif";
    outputorder="edgesfirst";
    compound="true";
    node [fontname="Helvetica,Arial,sans-serif", fontsize=12];
    edge [fontname="Helvetica,Arial,sans-serif", fontsize=10];

    p_USER_IN [label="", shape="circle", style="filled,dashed", fillcolor="#f8d7da", color="#721c24", penwidth=2, width=0.35, xlabel="USER_IN", fixedsize="true"];
    p_LLM_STREAMING [label="", shape="circle", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1.5, width=0.35, xlabel="LLM_STREAMING", fixedsize="true"];
    p_CHUNK_BUDGET [label="", shape="circle", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1.5, width=0.35, xlabel="CHUNK_BUDGET", fixedsize="true"];
    p_CHUNK_OUT [label="", shape="circle", style="filled,dashed", fillcolor="#f8d7da", color="#721c24", penwidth=2, width=0.35, xlabel="CHUNK_OUT", fixedsize="true"];
    p_INTERRUPTED [label="", shape="circle", style="filled,dashed", fillcolor="#f8d7da", color="#721c24", penwidth=2, width=0.35, xlabel="INTERRUPTED", fixedsize="true"];
    p_EVENT_OUT [label="", shape="circle", style="filled,dashed", fillcolor="#f8d7da", color="#721c24", penwidth=2, width=0.35, xlabel="EVENT_OUT", fixedsize="true"];
    p_VOICE_ACTIVITY_OPEN [label="", shape="circle", style="filled,dashed", fillcolor="#f8d7da", color="#721c24", penwidth=2, width=0.35, xlabel="VOICE_ACTIVITY_OPEN", fixedsize="true"];
    p_BARGE_DISCARDED [label="", shape="doublecircle", style="filled", fillcolor="#cce5ff", color="#004085", penwidth=2, width=0.35, xlabel="BARGE_DISCARDED", fixedsize="true"];
    p_RESPONSE_AWAITED [label="", shape="circle", style="filled,dashed", fillcolor="#f8d7da", color="#721c24", penwidth=2, width=0.35, xlabel="RESPONSE_AWAITED", fixedsize="true"];
    p_NUDGE_SENT [label="", shape="circle", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1.5, width=0.35, xlabel="NUDGE_SENT", fixedsize="true"];
    p_MODEL_ACTIVE [label="", shape="circle", style="filled,dashed", fillcolor="#f8d7da", color="#721c24", penwidth=2, width=0.35, xlabel="MODEL_ACTIVE", fixedsize="true"];
    p_RECONNECT_NEEDED [label="", shape="doublecircle", style="filled", fillcolor="#cce5ff", color="#004085", penwidth=2, width=0.35, xlabel="RECONNECT_NEEDED", fixedsize="true"];
    t_BeginStream [label="BeginStream [0, ∞]ms", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    t_EmitChunk [label="EmitChunk [0, ∞]ms", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    t_BargeInSend [label="BargeInSend [0, ∞]ms", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    t_BargeInDiscard [label="BargeInDiscard [0, ∞]ms", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    t_NudgeAfterTn [label="NudgeAfterTn [2000, ∞]ms", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    t_ReconnectAfterTr [label="ReconnectAfterTr [5000, ∞]ms", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    j_BeginStream__and_0 [label="✚", shape="diamond", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1, height=0.3, width=0.3, fixedsize="true", fontsize=14];
    j_EmitChunk__and_0 [label="✚", shape="diamond", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1, height=0.3, width=0.3, fixedsize="true", fontsize=14];
    j_NudgeAfterTn__and_0 [label="✚", shape="diamond", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1, height=0.3, width=0.3, fixedsize="true", fontsize=14];

    p_USER_IN -> t_BeginStream [color="#333333", style="solid", arrowhead="normal"];
    t_BeginStream -> j_BeginStream__and_0 [color="#333333", style="solid", arrowhead="normal"];
    j_BeginStream__and_0 -> p_LLM_STREAMING [color="#333333", style="solid", arrowhead="normal"];
    j_BeginStream__and_0 -> p_CHUNK_BUDGET [color="#fd7e14", style="bold", arrowhead="normal", label="reset+out", penwidth=2];
    j_BeginStream__and_0 -> p_CHUNK_BUDGET [color="#fd7e14", style="bold", arrowhead="normal", label="reset+out", penwidth=2];
    j_BeginStream__and_0 -> p_CHUNK_BUDGET [color="#fd7e14", style="bold", arrowhead="normal", label="reset+out", penwidth=2];
    p_CHUNK_BUDGET -> t_EmitChunk [color="#333333", style="solid", arrowhead="normal"];
    t_EmitChunk -> j_EmitChunk__and_0 [color="#333333", style="solid", arrowhead="normal"];
    j_EmitChunk__and_0 -> p_CHUNK_BUDGET [color="#333333", style="solid", arrowhead="normal"];
    j_EmitChunk__and_0 -> p_CHUNK_OUT [color="#333333", style="solid", arrowhead="normal"];
    p_LLM_STREAMING -> t_EmitChunk [color="#6c757d", style="dashed", arrowhead="normal", label="read"];
    p_INTERRUPTED -> t_BargeInSend [color="#333333", style="solid", arrowhead="normal"];
    t_BargeInSend -> p_EVENT_OUT [color="#333333", style="solid", arrowhead="normal"];
    p_VOICE_ACTIVITY_OPEN -> t_BargeInSend [color="#6c757d", style="dashed", arrowhead="normal", label="read"];
    p_INTERRUPTED -> t_BargeInDiscard [color="#333333", style="solid", arrowhead="normal"];
    t_BargeInDiscard -> p_BARGE_DISCARDED [color="#333333", style="solid", arrowhead="normal"];
    p_VOICE_ACTIVITY_OPEN -> t_BargeInDiscard [color="#dc3545", style="solid", arrowhead="odot"];
    p_RESPONSE_AWAITED -> t_NudgeAfterTn [color="#333333", style="solid", arrowhead="normal"];
    t_NudgeAfterTn -> j_NudgeAfterTn__and_0 [color="#333333", style="solid", arrowhead="normal"];
    j_NudgeAfterTn__and_0 -> p_RESPONSE_AWAITED [color="#333333", style="solid", arrowhead="normal"];
    j_NudgeAfterTn__and_0 -> p_NUDGE_SENT [color="#333333", style="solid", arrowhead="normal"];
    p_MODEL_ACTIVE -> t_NudgeAfterTn [color="#dc3545", style="solid", arrowhead="odot"];
    p_RESPONSE_AWAITED -> t_ReconnectAfterTr [color="#333333", style="solid", arrowhead="normal"];
    p_NUDGE_SENT -> t_ReconnectAfterTr [color="#333333", style="solid", arrowhead="normal"];
    t_ReconnectAfterTr -> p_RECONNECT_NEEDED [color="#333333", style="solid", arrowhead="normal"];
    p_MODEL_ACTIVE -> t_ReconnectAfterTr [color="#dc3545", style="solid", arrowhead="odot"];
}