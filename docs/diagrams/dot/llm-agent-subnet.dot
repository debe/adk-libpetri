digraph LlmAgentSubnet {
    rankdir=LR;
    nodesep=0.5;
    ranksep=0.75;
    forcelabels="true";
    overlap="false";
    fontname="Helvetica,Arial,sans-serif";
    outputorder="edgesfirst";
    compound="true";
    node [fontname="Helvetica,Arial,sans-serif", fontsize=12];
    edge [fontname="Helvetica,Arial,sans-serif", fontsize=10];

    p_USER_IN [label="", shape="circle", style="filled,dashed", fillcolor="#f8d7da", color="#721c24", penwidth=2, width=0.35, xlabel="USER_IN", fixedsize="true"];
    p_TURN_PERMIT [label="", shape="circle", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1.5, width=0.35, xlabel="TURN_PERMIT", fixedsize="true"];
    p_TURN_ACTIVE [label="", shape="circle", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1.5, width=0.35, xlabel="TURN_ACTIVE", fixedsize="true"];
    p_TURN_INPUT [label="", shape="circle", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1.5, width=0.35, xlabel="TURN_INPUT", fixedsize="true"];
    p_LLM_REQUEST [label="", shape="circle", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1.5, width=0.35, xlabel="LLM_REQUEST", fixedsize="true"];
    p_REASK_BUDGET [label="", shape="circle", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1.5, width=0.35, xlabel="REASK_BUDGET", fixedsize="true"];
    p_CONVERSATION [label="", shape="circle", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1.5, width=0.35, xlabel="CONVERSATION", fixedsize="true"];
    p_LLM_RESPONSE [label="", shape="circle", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1.5, width=0.35, xlabel="LLM_RESPONSE", fixedsize="true"];
    p_TOOL_CALLS [label="", shape="circle", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1.5, width=0.35, xlabel="TOOL_CALLS", fixedsize="true"];
    p_HANDOFF [label="", shape="circle", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1.5, width=0.35, xlabel="HANDOFF", fixedsize="true"];
    p_ANSWER [label="", shape="circle", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1.5, width=0.35, xlabel="ANSWER", fixedsize="true"];
    p_TOOL_RESULTS [label="", shape="circle", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1.5, width=0.35, xlabel="TOOL_RESULTS", fixedsize="true"];
    p_EVENT_OUT [label="", shape="circle", style="filled,dashed", fillcolor="#f8d7da", color="#721c24", penwidth=2, width=0.35, xlabel="EVENT_OUT", fixedsize="true"];
    p_TRANSFER [label="", shape="circle", style="filled,dashed", fillcolor="#f8d7da", color="#721c24", penwidth=2, width=0.35, xlabel="TRANSFER", fixedsize="true"];
    p_TURN_ABORT [label="", shape="circle", style="filled,dashed", fillcolor="#f8d7da", color="#721c24", penwidth=2, width=0.35, xlabel="TURN_ABORT", fixedsize="true"];
    t_StartTurn [label="StartTurn [0, ∞]ms", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    t_BuildPrompt [label="BuildPrompt [0, ∞]ms", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    t_LlmStep_Call [label="LlmStep_Call [0, ∞]ms", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    t_Router_Route [label="Router_Route [0, ∞]ms", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    t_ToolDispatch [label="ToolDispatch [0, ∞]ms", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    t_ReAsk [label="ReAsk [0, ∞]ms prio=10", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    t_ReAskExhausted [label="ReAskExhausted [0, ∞]ms prio=-10", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    t_EmitAnswer [label="EmitAnswer [0, ∞]ms", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    t_EmitTransfer [label="EmitTransfer [0, ∞]ms", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    t_AbortTurn [label="AbortTurn [0, ∞]ms prio=30", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    t_DropAbort [label="DropAbort [0, ∞]ms prio=30", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    j_StartTurn__and_0 [label="✚", shape="diamond", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1, height=0.3, width=0.3, fixedsize="true", fontsize=14];
    j_BuildPrompt__and_0 [label="✚", shape="diamond", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1, height=0.3, width=0.3, fixedsize="true", fontsize=14];
    j_Router_Route__xor_0 [label="✕", shape="diamond", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1, height=0.3, width=0.3, fixedsize="true", fontsize=14];
    j_ReAsk__and_0 [label="✚", shape="diamond", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1, height=0.3, width=0.3, fixedsize="true", fontsize=14];
    j_EmitAnswer__and_0 [label="✚", shape="diamond", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1, height=0.3, width=0.3, fixedsize="true", fontsize=14];
    j_EmitTransfer__and_0 [label="✚", shape="diamond", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1, height=0.3, width=0.3, fixedsize="true", fontsize=14];

    p_USER_IN -> t_StartTurn [color="#333333", style="solid", arrowhead="normal"];
    p_TURN_PERMIT -> t_StartTurn [color="#333333", style="solid", arrowhead="normal"];
    t_StartTurn -> j_StartTurn__and_0 [color="#333333", style="solid", arrowhead="normal"];
    j_StartTurn__and_0 -> p_TURN_ACTIVE [color="#333333", style="solid", arrowhead="normal"];
    j_StartTurn__and_0 -> p_TURN_INPUT [color="#333333", style="solid", arrowhead="normal"];
    p_TURN_INPUT -> t_BuildPrompt [color="#333333", style="solid", arrowhead="normal"];
    t_BuildPrompt -> j_BuildPrompt__and_0 [color="#333333", style="solid", arrowhead="normal"];
    j_BuildPrompt__and_0 -> p_LLM_REQUEST [color="#333333", style="solid", arrowhead="normal"];
    j_BuildPrompt__and_0 -> p_REASK_BUDGET [color="#333333", style="solid", arrowhead="normal"];
    j_BuildPrompt__and_0 -> p_CONVERSATION [color="#333333", style="solid", arrowhead="normal"];
    p_LLM_REQUEST -> t_LlmStep_Call [color="#333333", style="solid", arrowhead="normal"];
    t_LlmStep_Call -> p_LLM_RESPONSE [color="#333333", style="solid", arrowhead="normal"];
    p_LLM_RESPONSE -> t_Router_Route [color="#333333", style="solid", arrowhead="normal"];
    t_Router_Route -> j_Router_Route__xor_0 [color="#333333", style="solid", arrowhead="normal"];
    j_Router_Route__xor_0 -> p_TOOL_CALLS [color="#333333", style="solid", arrowhead="normal", label="TOOL_CALLS"];
    j_Router_Route__xor_0 -> p_HANDOFF [color="#333333", style="solid", arrowhead="normal", label="HANDOFF"];
    j_Router_Route__xor_0 -> p_ANSWER [color="#333333", style="solid", arrowhead="normal", label="ANSWER"];
    p_TOOL_CALLS -> t_ToolDispatch [color="#333333", style="solid", arrowhead="normal"];
    t_ToolDispatch -> p_TOOL_RESULTS [color="#333333", style="solid", arrowhead="normal"];
    p_TOOL_RESULTS -> t_ReAsk [color="#333333", style="solid", arrowhead="normal"];
    p_REASK_BUDGET -> t_ReAsk [color="#333333", style="solid", arrowhead="normal"];
    p_CONVERSATION -> t_ReAsk [color="#333333", style="solid", arrowhead="normal"];
    t_ReAsk -> j_ReAsk__and_0 [color="#333333", style="solid", arrowhead="normal"];
    j_ReAsk__and_0 -> p_LLM_REQUEST [color="#333333", style="solid", arrowhead="normal"];
    j_ReAsk__and_0 -> p_CONVERSATION [color="#333333", style="solid", arrowhead="normal"];
    p_TOOL_RESULTS -> t_ReAskExhausted [color="#333333", style="solid", arrowhead="normal"];
    t_ReAskExhausted -> p_ANSWER [color="#333333", style="solid", arrowhead="normal"];
    p_REASK_BUDGET -> t_ReAskExhausted [color="#dc3545", style="solid", arrowhead="odot"];
    p_ANSWER -> t_EmitAnswer [color="#333333", style="solid", arrowhead="normal"];
    p_TURN_ACTIVE -> t_EmitAnswer [color="#333333", style="solid", arrowhead="normal"];
    p_CONVERSATION -> t_EmitAnswer [color="#333333", style="solid", arrowhead="normal"];
    t_EmitAnswer -> j_EmitAnswer__and_0 [color="#333333", style="solid", arrowhead="normal"];
    j_EmitAnswer__and_0 -> p_EVENT_OUT [color="#333333", style="solid", arrowhead="normal"];
    j_EmitAnswer__and_0 -> p_TURN_PERMIT [color="#333333", style="solid", arrowhead="normal"];
    t_EmitAnswer -> p_REASK_BUDGET [color="#fd7e14", style="bold", arrowhead="normal", label="reset", penwidth=2];
    p_HANDOFF -> t_EmitTransfer [color="#333333", style="solid", arrowhead="normal"];
    p_TURN_ACTIVE -> t_EmitTransfer [color="#333333", style="solid", arrowhead="normal"];
    p_CONVERSATION -> t_EmitTransfer [color="#333333", style="solid", arrowhead="normal"];
    t_EmitTransfer -> j_EmitTransfer__and_0 [color="#333333", style="solid", arrowhead="normal"];
    j_EmitTransfer__and_0 -> p_TRANSFER [color="#333333", style="solid", arrowhead="normal"];
    j_EmitTransfer__and_0 -> p_TURN_PERMIT [color="#333333", style="solid", arrowhead="normal"];
    t_EmitTransfer -> p_REASK_BUDGET [color="#fd7e14", style="bold", arrowhead="normal", label="reset", penwidth=2];
    p_TURN_ABORT -> t_AbortTurn [color="#333333", style="solid", arrowhead="normal"];
    p_TURN_ACTIVE -> t_AbortTurn [color="#333333", style="solid", arrowhead="normal"];
    t_AbortTurn -> p_TURN_PERMIT [color="#333333", style="solid", arrowhead="normal"];
    t_AbortTurn -> p_CONVERSATION [color="#fd7e14", style="bold", arrowhead="normal", label="reset", penwidth=2];
    t_AbortTurn -> p_REASK_BUDGET [color="#fd7e14", style="bold", arrowhead="normal", label="reset", penwidth=2];
    p_TURN_ABORT -> t_DropAbort [color="#333333", style="solid", arrowhead="normal"];
    p_TURN_PERMIT -> t_DropAbort [color="#6c757d", style="dashed", arrowhead="normal", label="read"];
}