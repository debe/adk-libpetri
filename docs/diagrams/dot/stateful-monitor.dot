digraph StatefulMonitor {
    rankdir=LR;
    nodesep=0.5;
    ranksep=0.75;
    forcelabels="true";
    overlap="false";
    fontname="Helvetica,Arial,sans-serif";
    outputorder="edgesfirst";
    compound="true";
    node [fontname="Helvetica,Arial,sans-serif", fontsize=12];
    edge [fontname="Helvetica,Arial,sans-serif", fontsize=10];

    p_SEARCH_REQUEST [label="", shape="circle", style="filled,dashed", fillcolor="#f8d7da", color="#721c24", penwidth=2, width=0.35, xlabel="SEARCH_REQUEST", fixedsize="true"];
    p_COLLECTOR [label="", shape="circle", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1.5, width=0.35, xlabel="COLLECTOR", fixedsize="true"];
    p_JOB_A [label="", shape="circle", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1.5, width=0.35, xlabel="JOB_A", fixedsize="true"];
    p_JOB_B [label="", shape="circle", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1.5, width=0.35, xlabel="JOB_B", fixedsize="true"];
    p_JOB_C [label="", shape="circle", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1.5, width=0.35, xlabel="JOB_C", fixedsize="true"];
    p_SEARCH_RESULT [label="", shape="circle", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1.5, width=0.35, xlabel="SEARCH_RESULT", fixedsize="true"];
    p_SELECTION_READY [label="", shape="circle", style="filled,dashed", fillcolor="#f8d7da", color="#721c24", penwidth=2, width=0.35, xlabel="SELECTION_READY", fixedsize="true"];
    p_OTHER_INPUT [label="", shape="circle", style="filled,dashed", fillcolor="#f8d7da", color="#721c24", penwidth=2, width=0.35, xlabel="OTHER_INPUT", fixedsize="true"];
    p_OTHER_DOWNSTREAM [label="", shape="circle", style="filled,dashed", fillcolor="#f8d7da", color="#721c24", penwidth=2, width=0.35, xlabel="OTHER_DOWNSTREAM", fixedsize="true"];
    p_USER_NEW_TURN [label="", shape="circle", style="filled,dashed", fillcolor="#f8d7da", color="#721c24", penwidth=2, width=0.35, xlabel="USER_NEW_TURN", fixedsize="true"];
    t_SpawnJobs [label="SpawnJobs [0, ∞]ms", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    t_WorkerA [label="WorkerA [0, ∞]ms", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    t_WorkerB [label="WorkerB [0, ∞]ms", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    t_WorkerC [label="WorkerC [0, ∞]ms", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    t_CollectResult [label="CollectResult [0, ∞]ms", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    t_OrthogonalRead [label="OrthogonalRead [0, ∞]ms", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    t_OnNewUserTurn [label="OnNewUserTurn [0, ∞]ms", shape="box", style="filled", fillcolor="#fff3cd", color="#856404", penwidth=1, height=0.4, width=0.8];
    j_SpawnJobs__and_0 [label="✚", shape="diamond", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1, height=0.3, width=0.3, fixedsize="true", fontsize=14];
    j_CollectResult__xor_0 [label="✕", shape="diamond", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1, height=0.3, width=0.3, fixedsize="true", fontsize=14];
    j_CollectResult__and_1 [label="✚", shape="diamond", style="filled", fillcolor="#FFFFFF", color="#333333", penwidth=1, height=0.3, width=0.3, fixedsize="true", fontsize=14];

    p_SEARCH_REQUEST -> t_SpawnJobs [color="#333333", style="solid", arrowhead="normal"];
    p_COLLECTOR -> t_SpawnJobs [color="#333333", style="solid", arrowhead="normal"];
    t_SpawnJobs -> j_SpawnJobs__and_0 [color="#333333", style="solid", arrowhead="normal"];
    j_SpawnJobs__and_0 -> p_JOB_A [color="#333333", style="solid", arrowhead="normal"];
    j_SpawnJobs__and_0 -> p_JOB_B [color="#333333", style="solid", arrowhead="normal"];
    j_SpawnJobs__and_0 -> p_JOB_C [color="#333333", style="solid", arrowhead="normal"];
    j_SpawnJobs__and_0 -> p_COLLECTOR [color="#333333", style="solid", arrowhead="normal"];
    p_JOB_A -> t_WorkerA [color="#333333", style="solid", arrowhead="normal"];
    t_WorkerA -> p_SEARCH_RESULT [color="#333333", style="solid", arrowhead="normal"];
    p_JOB_B -> t_WorkerB [color="#333333", style="solid", arrowhead="normal"];
    t_WorkerB -> p_SEARCH_RESULT [color="#333333", style="solid", arrowhead="normal"];
    p_JOB_C -> t_WorkerC [color="#333333", style="solid", arrowhead="normal"];
    t_WorkerC -> p_SEARCH_RESULT [color="#333333", style="solid", arrowhead="normal"];
    p_SEARCH_RESULT -> t_CollectResult [color="#333333", style="solid", arrowhead="normal"];
    p_COLLECTOR -> t_CollectResult [color="#333333", style="solid", arrowhead="normal"];
    t_CollectResult -> j_CollectResult__xor_0 [color="#333333", style="solid", arrowhead="normal"];
    j_CollectResult__xor_0 -> p_COLLECTOR [color="#333333", style="solid", arrowhead="normal", label="COLLECTOR"];
    j_CollectResult__xor_0 -> j_CollectResult__and_1 [color="#333333", style="solid", arrowhead="normal"];
    j_CollectResult__and_1 -> p_COLLECTOR [color="#333333", style="solid", arrowhead="normal"];
    j_CollectResult__and_1 -> p_SELECTION_READY [color="#333333", style="solid", arrowhead="normal"];
    p_OTHER_INPUT -> t_OrthogonalRead [color="#333333", style="solid", arrowhead="normal"];
    t_OrthogonalRead -> p_OTHER_DOWNSTREAM [color="#333333", style="solid", arrowhead="normal"];
    p_COLLECTOR -> t_OrthogonalRead [color="#6c757d", style="dashed", arrowhead="normal", label="read"];
    p_USER_NEW_TURN -> t_OnNewUserTurn [color="#333333", style="solid", arrowhead="normal"];
    t_OnNewUserTurn -> p_COLLECTOR [color="#fd7e14", style="bold", arrowhead="normal", label="reset+out", penwidth=2];
    t_OnNewUserTurn -> p_JOB_A [color="#fd7e14", style="bold", arrowhead="normal", label="reset", penwidth=2];
    t_OnNewUserTurn -> p_JOB_B [color="#fd7e14", style="bold", arrowhead="normal", label="reset", penwidth=2];
    t_OnNewUserTurn -> p_JOB_C [color="#fd7e14", style="bold", arrowhead="normal", label="reset", penwidth=2];
    t_OnNewUserTurn -> p_SEARCH_RESULT [color="#fd7e14", style="bold", arrowhead="normal", label="reset", penwidth=2];
}